pipeline{
    agent any
    
    stages{
        stage('Checkout SCM') {
            steps {
                script {
                    checkout scm
                }
            }
        }
        stage("Install Dependencies"){
            steps{
                echo "Installing Dependencis..."
                script {
                    sh 'npm install'
                }
            }
        }
        stage('Run App') {
            steps {
                echo "Running nodejs App.."
                script{
                    sh """
                        pkill -f "node app.js" || true
                        nohup node app.js > app.log 2>&1 &
                        sleep 60
                        curl http://localhost:3001 || echo "App is not Responding!"
                    """
                }
            }
        }
    }
    post {
        always {
            echo "Cleaning up..."
        }
    }
}
